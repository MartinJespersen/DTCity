-  return block;  
+  #if MI_TRACK_ASAN && MI_PADDING
+  // The allocator temporarily unpoisons the rounded block while initializing it.
+  // Restore the red zone before returning the requested range to the caller.
+  mi_track_mem_noaccess((uint8_t*)block + size - MI_PADDING_SIZE,
+                        mi_page_block_size(page) - (size - MI_PADDING_SIZE));
+  #endif
+  return block;
 }
 
