#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform UBO_Camera
{
    mat4 view;
    mat4 projection;
    vec4 frustum_planes[6];
    vec2 viewport_dim;
} camera_ubo;
// Word offsets honor the CPU PrimitiveVertex layout, including GLM padding.
layout(std430, set = 0, binding = 1) readonly buffer Vertices { uint words[]; } vertices;
layout(std430, set = 0, binding = 2) readonly buffer Meshlets { uint words[]; } meshlets;
layout(std430, set = 0, binding = 3) readonly buffer Transforms { mat4 models[]; } transforms;
layout(push_constant) uniform PushConstants
{
    uint first_meshlet;
    uint first_instance;
    uint transform_offset;
    uint vertex_stride;
    uint position_offset;
    uint normal_offset;
    uint color_offset;
    uint uv_offset;
    uint texture_index;
    uint textured;
    float lod_error_pixels;
} pc;

struct LodPayload { uint descriptor; uint instance_index; };
taskPayloadSharedEXT LodPayload payload;
void main()
{
    uint instance_index = pc.transform_offset + pc.first_instance + gl_WorkGroupID.y;
    mat4 model = transforms.models[instance_index];
    vec3 center = uintBitsToFloat(uvec3(meshlets.words[0], meshlets.words[1], meshlets.words[2]));
    float radius = uintBitsToFloat(meshlets.words[3]);
    // Frobenius norm bounds stretch even for nonuniform scale/shear.
    float stretch = sqrt(dot(model[0].xyz, model[0].xyz) + dot(model[1].xyz, model[1].xyz) + dot(model[2].xyz, model[2].xyz));
    vec3 view_center = (camera_ubo.view * model * vec4(center, 1)).xyz;
    float nearest_depth = -view_center.z - radius * stretch;
    float projection_scale = abs(camera_ubo.projection[1][1]) * camera_ubo.viewport_dim.y * 0.5;
    uint lod = 0;
    if (pc.lod_error_pixels > 0 && nearest_depth > 0)
    {
        for (uint candidate = 1; candidate < meshlets.words[4]; ++candidate)
        {
            float error = uintBitsToFloat(meshlets.words[10 + candidate * 4]);
            float pixels = error * stretch * projection_scale / nearest_depth;
            if (pixels <= pc.lod_error_pixels) { lod = candidate; }
        }
    }
    uint first_meshlet = (pc.first_meshlet + gl_WorkGroupID.x) * 32;
    uint count = meshlets.words[9 + lod * 4];
    uint emitted = first_meshlet < count ? min(32u, count - first_meshlet) : 0;
    payload.descriptor = meshlets.words[8 + lod * 4] + first_meshlet * 4;
    payload.instance_index = instance_index;
    EmitMeshTasksEXT(emitted, 1, 1);
}
