include_guard(GLOBAL)

find_package(mimalloc 3.5.3 EXACT CONFIG REQUIRED)
include("${mimalloc_DIR}/dtcity-mimalloc-config.cmake")

add_library(dtcity_mimalloc INTERFACE)
target_link_libraries(dtcity_mimalloc INTERFACE mimalloc-static)

# ASan must be enabled in both the allocator package and its consumers.
if(ASAN_ENABLED)
  if(NOT DTCITY_MIMALLOC_TRACK STREQUAL "ASAN")
    message(FATAL_ERROR "ASAN_ENABLED requires a DTCity ASan vcpkg triplet; reconfigure in a fresh build directory")
  endif()
  target_compile_definitions(dtcity_mimalloc INTERFACE ASAN_ENABLED=1 DTCITY_MIMALLOC_ASAN=1)
  if(MSVC)
    foreach(flags CMAKE_C_FLAGS_DEBUG CMAKE_CXX_FLAGS_DEBUG)
      string(REPLACE "/RTC1" "" ${flags} "${${flags}}")
    endforeach()
    target_compile_options(dtcity_mimalloc INTERFACE /fsanitize=address)
    target_link_options(dtcity_mimalloc INTERFACE /INCREMENTAL:NO)
  else()
    target_compile_options(dtcity_mimalloc INTERFACE -fsanitize=address)
    target_link_options(dtcity_mimalloc INTERFACE -fsanitize=address)
  endif()
elseif(DTCITY_MIMALLOC_TRACK STREQUAL "ASAN")
  message(FATAL_ERROR "The selected mimalloc package requires ASAN_ENABLED; use a non-ASan triplet for this build")
endif()
