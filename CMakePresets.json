{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "ASAN_ENABLED": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DEBUG": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TRACY_PROFILE_ENABLE": "ON"
      }
    },
    {
      "name": "debug-windows",
      "displayName": "Debug (Windows)",
      "inherits": "debug-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win/debug",
      "cacheVariables": {
        "ASAN_ENABLED": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "debug-windows-clang",
      "displayName": "Debug (Windows Clang)",
      "inherits": "debug-windows",
      "binaryDir": "${sourceDir}/build/win/clang-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ASAN_ENABLED": "OFF",
        "USE_RADLINKER": "OFF"
      }
    },
    {
      "name": "debug-simulator-linux",
      "displayName": "Debug Simulator (Linux)",
      "binaryDir": "${sourceDir}/simulator/build/linux/debug",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_DEBUG": "ON",
        "ASAN_ENABLED": "ON",
        "BUILD_CITY": "OFF",
        "BUILD_SIMULATOR": "ON",
        "TRACY_PROFILE_ENABLE": "OFF"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug (Linux)",
      "inherits": "debug-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux/debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Release (Windows)",
      "inherits": "release-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win/release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "release-static-windows",
      "displayName": "Release DTCity and Simulator (Windows, static runtime)",
      "inherits": "release-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win/release-static",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_CITY": "ON",
        "BUILD_SIMULATOR": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_DEBUG": "OFF",
        "SHADER_DEBUG": "OFF",
        "ASAN_ENABLED": "OFF",
        "TRACY_PROFILE_ENABLE": "OFF",
        "USE_RADLINKER": "OFF"
      }
    },
    {
      "name": "release-simulator-windows",
      "displayName": "Release Simulator (Windows)",
      "binaryDir": "${sourceDir}/simulator/build/win/release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DEBUG": "OFF",
        "ASAN_ENABLED": "OFF",
        "BUILD_CITY": "OFF",
        "BUILD_SIMULATOR": "ON",
        "TRACY_PROFILE_ENABLE": "OFF"
      }
    },
    {
      "name": "release-simulator-linux",
      "displayName": "Release Simulator (Linux)",
      "binaryDir": "${sourceDir}/simulator/build/linux/release",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DEBUG": "OFF",
        "ASAN_ENABLED": "OFF",
        "BUILD_CITY": "OFF",
        "BUILD_SIMULATOR": "ON",
        "TRACY_PROFILE_ENABLE": "OFF"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release (Linux)",
      "inherits": "release-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux/release",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "profile-simulator-linux",
      "displayName": "Profile Simulator (Linux)",
      "binaryDir": "${sourceDir}/simulator/build/linux/profile",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TRACY_PROFILE_ENABLE": "ON",
        "ASAN_ENABLED": "OFF",
        "BUILD_CITY": "OFF",
        "BUILD_SIMULATOR": "ON"
      }
    },
    {
      "name": "profile-windows",
      "displayName": "Profile (Windows)",
      "inherits": "profile-base",
      "binaryDir": "${sourceDir}/build/win/profile",
      "generator": "Ninja",
      "cacheVariables": {
        "SHADER_DEBUG": "OFF",
        "ASAN_ENABLED": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "profile-linux",
      "displayName": "Profile (Linux)",
      "inherits": "profile-base",
      "binaryDir": "${sourceDir}/build/linux/profile",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "package-release-static-windows",
      "configurePreset": "release-static-windows",
      "targets": ["package-runtime"],
      "jobs": 0
    },
    {
      "name": "release-static-windows",
      "configurePreset": "release-static-windows",
      "targets": [
        "city",
        "Simulator"
      ],
      "jobs": 0
    },
    {
      "name": "debug-simulator-linux",
      "configurePreset": "debug-simulator-linux",
      "targets": [
        "Simulator"
      ],
      "jobs": 0
    },
    {
      "name": "profile-simulator-linux",
      "configurePreset": "profile-simulator-linux",
      "targets": [
        "Simulator"
      ],
      "jobs": 0
    },
    {
      "name": "release-simulator-linux",
      "configurePreset": "release-simulator-linux",
      "targets": [
        "Simulator"
      ],
      "jobs": 0
    }
  ]
}
