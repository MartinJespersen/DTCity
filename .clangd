If:
  PathMatch: .*
CompileFlags:
  CompilationDatabase: build/linux/debug
  Remove: [-include, -include-pch]
  Compiler: clang++

Index:
  Background: Build
  StandardLibrary: false

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - undefined-internal
    - tautological-pointer-compare
    - c99-designator
    - c++11-narrowing
    - missing-designated-field-initializers
    - missing-field-initializers
    - unused-function
    - drv_argument_not_allowed_with
    - missing-braces
  ClangTidy:
    FastCheckFilter: Strict
Hover:
  ShowAKA: true
---
If:
  PathMatch: (src\/third_party\/os_core|src\/http)\/.*
Diagnostics:
  Suppress: "*"
CompileFlags:
  Add: -ferror-limit=0

---
If:
  PathMatch: tests/.*
CompileFlags:
  CompilationDatabase: build/linux/crash-tests
  Remove: [-include, -include-pch]

---
If:
  PathMatch: simulator/.*
CompileFlags:
  CompilationDatabase: simulator/build/linux/debug
  Remove: [-include, -include-pch]

# These implementation files and headers are compiled inside C++ unity units.
---
If:
  PathMatch: (src|tests|simulator)/.*\.(c|h)
  PathExclude: .*/third_party/.*
CompileFlags:
  Add: [-x, c++, -std=c++20]
