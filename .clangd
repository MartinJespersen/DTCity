If:
  PathMatch: .*
CompileFlags:
  # Builds copy compile_commands.json to the project directory on either host.
  CompilationDatabase: Ancestors
  # Keep the database's compiler so MSVC and Clang flags use the correct driver.
  # clangd builds its own preamble; it cannot use MSVC's compiled PCH.
  # Sanitizer instrumentation is unnecessary for parsing and conflicts with /MDd.
  Remove: [-include, -include-pch, /Yu*, /Yc*, /Fp*, /fsanitize=*, -fsanitize=*]
Completion:
  HeaderInsertion: Never

Index:
  Background: Build
  StandardLibrary: false

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None
  Suppress:
    - undefined-internal
    - tautological-pointer-compare
    - c99-designator
    - c++11-narrowing
    - missing-designated-field-initializers
    - missing-field-initializers
    - unused-function
    - drv_argument_not_allowed_with
    - missing-braces
  ClangTidy:
    FastCheckFilter: Strict
Hover:
  ShowAKA: true
---
If:
  PathMatch: (src\/third_party\/os_core|src\/http)\/.*
Diagnostics:
  Suppress: "*"
CompileFlags:
  Add: -ferror-limit=0

# These implementation files and headers are compiled inside C++ unity units.
---
If:
  PathMatch: (src|tests|simulator)/.*\.(c|h)
  PathExclude: .*/third_party/.*
CompileFlags:
  Add: [-x, c++, -std=c++20]
